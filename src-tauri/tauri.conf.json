{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Quest Pro Touch Plus",
  "version": "../package.json",
  "identifier": "dev.lateir.qptp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quest Pro Touch Plus",
        "width": 780,
        "height": 330,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "resources/platform-tools/*"
    ]
  }
}
